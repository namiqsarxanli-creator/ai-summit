# FAKE values, for `docker compose ... config --quiet` in CI only.
#
# They exist so the production Compose file can be validated (required
# variables present, interpolation correct) without any real secret anywhere
# near CI. Nothing here is, or may ever be, a real credential; the file is not
# read by the application and `deploy/preflight.sh` would (rightly) reject it.
DOMAIN=summit.ci-fake.invalid
APP_ORIGIN=https://summit.ci-fake.invalid
ACME_EMAIL=ops@ci-fake.invalid
POSTGRES_PASSWORD=ci_fake_database_password_not_real
SCAN_REF_SECRET=ci_fake_scan_ref_secret_not_real_0123456789
RESEND_API_KEY=ci_fake_resend_key_not_real
OTP_FROM_EMAIL=FACEMARK <ops@ci-fake.invalid>
OTP_OUTBOX_ENCRYPTION_KEY=ci_fake_outbox_key_not_real
