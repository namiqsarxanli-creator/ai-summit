# FACEMARK PRODUCTION environment - TEMPLATE.
#
#   cp .env.production.example .env.production      # then edit
#   docker compose --env-file .env.production -f docker-compose.prod.yml config --quiet
#
# .env.production is git-ignored (only this template is tracked). It holds
# real secrets: keep it on the server, readable by the deploy user only
# (chmod 600), and never paste its values into chat, tickets or logs.
#
# Every value below is a PLACEHOLDER. The backend refuses to start on the
# obvious ones (REPLACE_ME..., example/localhost domains, development
# secrets, http:// origin) - that is intentional. deploy/preflight.sh
# checks this file before you deploy.
#
# ENVIRONMENT=production and DEMO_MODE=false are fixed inside
# docker-compose.prod.yml; do not add them here.

# ---------------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------------
# The host name attendees type, with DNS already pointing at this server.
# Caddy obtains the HTTPS certificate for it automatically.
DOMAIN=REPLACE_ME.your-domain.tld
# https://<DOMAIN> - exactly, no path, no trailing slash. Used for the CSRF
# Origin check and to mark the session cookie Secure.
APP_ORIGIN=https://REPLACE_ME.your-domain.tld
# Contact address Let's Encrypt can use for expiry notices.
ACME_EMAIL=REPLACE_ME@your-domain.tld

# ---------------------------------------------------------------------------
# Secrets - generate each one yourself, e.g. `openssl rand -hex 32`
# ---------------------------------------------------------------------------
# Database password. Use hex/base64url characters only (it is placed inside
# a connection URL). Set it BEFORE the first start: it is baked into the
# database volume when the volume is first created.
POSTGRES_PASSWORD=REPLACE_ME_database_password
# HMAC key signing staff scan references. At least 32 characters.
SCAN_REF_SECRET=REPLACE_ME_scan_ref_secret_at_least_32_chars

# ---------------------------------------------------------------------------
# OTP email (Resend) - REQUIRED in production, there is no demo fallback
# ---------------------------------------------------------------------------
# API key from https://resend.com/api-keys, scoped to sending.
RESEND_API_KEY=REPLACE_ME_resend_api_key
# Must use a domain verified in Resend (SPF/DKIM) or codes land in spam.
OTP_FROM_EMAIL=AI Summit <REPLACE_ME@your-verified-domain.tld>
# Encrypts OTP codes while they wait in the delivery outbox (the database
# never holds them in the clear). 32 random bytes, URL-safe base64. Generate:
#   docker run --rm --entrypoint python facemark-backend:<tag> -m app.modules.auth.otp_crypto
# Keep it as secret as RESEND_API_KEY. To rotate it, see DEPLOYMENT.md.
OTP_OUTBOX_ENCRYPTION_KEY=REPLACE_ME_generated_with_generate-otp-key

# ---------------------------------------------------------------------------
# Optional - the defaults are fine for a single server
# ---------------------------------------------------------------------------
# OTP e-mail pacing: at most LIMIT sends start per WINDOW seconds. Set it BELOW your
# e-mail provider's request limit (Resend's default: 2 requests/second). Defaults 2 / 1.
#OTP_DELIVERY_RATE_LIMIT=2
#OTP_DELIVERY_RATE_WINDOW_SECONDS=1
# Only while rotating OTP_OUTBOX_ENCRYPTION_KEY: the OLD key, kept for 15
# minutes so codes queued under it can still be sent. Remove it afterwards.
#OTP_OUTBOX_ENCRYPTION_KEY_PREVIOUS=
#POSTGRES_USER=facemark
#POSTGRES_DB=facemark
# Tag for the built images. Change it on every release so the previous
# images stay on the server for rollback (see DEPLOYMENT.md).
#FACEMARK_VERSION=2026.10.1
# Host ports the proxy publishes. Leave at 80/443 on a real server.
#HTTP_PORT=80
#HTTPS_PORT=443
# Private network the stack runs on. The reverse proxy gets the fixed
# PROXY_IPV4 inside it, and ONLY that address is trusted for
# X-Forwarded-For. Change both together if 172.30.77.0/24 clashes with
# another network on the server; PROXY_IPV4 must lie inside INTERNAL_SUBNET.
#INTERNAL_SUBNET=172.30.77.0/24
#PROXY_IPV4=172.30.77.10

# Beyond Now Founder (+10 / Lucky Draw). The organiser has NOT confirmed which
# activities complete a zone: keep false. After they decide, set true AND run the
# recomputation in BEYOND_NOW.md ("Runtime safeguards"); then take a new snapshot.
FOUNDER_RULE_CONFIRMED=false
