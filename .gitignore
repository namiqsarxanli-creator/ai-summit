# Secrets — never committed. .env.example is the tracked template.
.env
.env.*
!.env.example
!.env.production.example

# --- Backend (Python) ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
backend/.venv/

# --- Frontend (Node / Next.js) ---
node_modules/
.next/
out/
coverage/
frontend/.next/
frontend/node_modules/
*.tsbuildinfo
npm-debug.log*

# --- Editors / OS noise ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Local data / logs ---
*.log

# Device-specific local HTTPS profile (public certificate, generated on this PC).
frontend/public/phone-ca.mobileconfig

# Local UI review screenshots (hundreds of MB) and IDE run configurations.
design-review/
.run/
