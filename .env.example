# FACEMARK local/demo environment configuration.
#
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# .env is git-ignored (ARCHITECTURE.md invariant #14 — no secret has a
# source-code fallback default; missing config fails at startup, it is
# never silently guessed). The placeholder values below are for local
# development only and must never be reused anywhere else.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# "development" | "production" — read by the backend (app/core/config.py)
# to decide things like whether /docs is exposed.
ENVIRONMENT=development

# M04 (ARCHITECTURE.md §8.2): when true, activation/login OTP codes are
# written to the backend's server log instead of being emailed — the
# only supported delivery path until a real email provider is added.
# The backend refuses to start if this is true while ENVIRONMENT is
# production (app/core/config.py).
DEMO_MODE=true

# M05 (ARCHITECTURE.md §8.3.1): the origin the BROWSER uses to reach the
# site — the frontend, never the backend port. Every POST/PUT/PATCH/
# DELETE must carry a matching Origin (or Referer) header or it is
# rejected with CSRF_REJECTED. Its scheme also decides the session
# cookie's Secure flag (https:// => Secure). Required; no default.
APP_ORIGIN=http://localhost:3000

# M05 (ARCHITECTURE.md §21.7.1): comma-separated CIDRs of proxies whose
# X-Forwarded-For may be trusted for rate-limit identity. Empty = trust
# nothing (the safe default): every request is identified by its direct
# peer, which behind the Next.js proxy means all traffic shares ONE
# shared-IP bucket. For a venue deployment, set this to exactly the
# proxy hop(s) in front of the backend (e.g. the frontend container's
# address) — never a broad range that also covers untrusted clients.
TRUSTED_PROXY_CIDRS=

# M10 (ARCHITECTURE.md §13.3): the HMAC key that signs every `scan_ref`
# envelope issued by the staff scan-resolve endpoint. Required; no
# fallback (invariant #14) — a guessed key would let anyone forge a
# staff scan of any attendee token. Generate a real one for any
# deployment, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
SCAN_REF_SECRET=facemark_dev_only_change_me_scan_ref_secret

# ---------------------------------------------------------------------------
# PostgreSQL (the `db` Compose service)
# ---------------------------------------------------------------------------
# These four are consumed directly by the official postgres image AND
# used by docker-compose.yml to assemble the backend's DATABASE_URL —
# one source of truth for credentials, never duplicated.
POSTGRES_USER=facemark
POSTGRES_PASSWORD=facemark_dev_only_change_me
POSTGRES_DB=facemark
# Host-side port mapping. Changed from Postgres's default 5432 because
# that port is commonly already bound by another local service.
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Backend (the `backend` Compose service)
# ---------------------------------------------------------------------------
# Host-side port mapping for direct backend access (e.g. /docs during
# development). The browser must never be told this port — it only
# ever talks to the frontend origin (ARCHITECTURE.md §3.2).
BACKEND_PORT=8001

# ---------------------------------------------------------------------------
# Frontend (the `frontend` Compose service)
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000

# Container-to-container base URL the Next.js rewrite proxy forwards
# /api/* requests to (next.config.ts). "backend" is the Compose service
# DNS name, not localhost — this value is meaningless outside the
# Compose network. Includes /api so the backend's own route paths
# (GET /api/health, etc.) match the contract documented throughout
# ARCHITECTURE.md exactly, with no prefix added or stripped by the proxy.
BACKEND_INTERNAL_URL=http://backend:8000/api

# ---------------------------------------------------------------------------
# Demo seed (M03) — `python -m app.cli seed` inside the backend container
# ---------------------------------------------------------------------------
# Passwords for the seeded demo staff accounts (app/seed/demo_fixtures.py):
# one shared password for every seeded BOOTH_STAFF account, one for the
# seeded ADMIN account. No fallback exists in code — the CLI fails loudly
# if either is unset (ARCHITECTURE.md §19.8, invariant #14). Change these
# placeholders for any deployment that is more than a local/dev demo.
SEED_ADMIN_PASSWORD=facemark_demo_admin_change_me
SEED_STAFF_PASSWORD=facemark_demo_staff_change_me
